# PostgreSQL connection string (Neon, Supabase, Railway, or your own server)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pricerealestateright?schema=public"

# Public URL of the site (used in emails and links)
APP_URL="https://www.pricerealestateright.com"

# Resend (https://resend.com) — leave RESEND_API_KEY empty to log emails to the console instead
RESEND_API_KEY=""
EMAIL_FROM="PriceRealEstateRight <games@pricerealestateright.com>"

# Timezone that weekly games run in (Saturday 3:00 AM -> Friday 11:59 PM)
GAME_TIMEZONE="America/New_York"

# Sister sites
NEXT_PUBLIC_MLS_SITE_URL="https://www.mlscomps.com"
NEXT_PUBLIC_MORTGAGE_SITE_URL="https://www.pricemortgageright.com"
# Shared secret the sister sites use to call /api/sister-sites/verify
SISTER_SITE_SECRET="change-me-to-a-long-random-string"

# Folder where uploaded photos are stored (must be persistent disk). Leave empty to use ./uploads
UPLOAD_DIR=""

# First admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@pricerealestateright.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
